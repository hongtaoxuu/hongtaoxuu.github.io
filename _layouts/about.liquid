---
layout: default
---
<div class="post about-page">
  <article>
    <div class="about-intro">
      <header class="post-header">
        <h1 class="post-title">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>
        {% if page.subtitle %}
          <p class="desc">{{ page.subtitle }}</p>
        {% endif %}
      </header>

      {% if page.profile %}
        <div class="profile">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
            {% endif %}
            {% assign sizes = '(min-width: 768px) 220px, 196px' %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image_alt
              width=page.profile.image_width height=page.profile.image_height caption=page.profile.caption
              cache_bust=true
            %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
      {% endif %}

      <div class="about-summary">
        <div class="about-biography">{{ content }}</div>

        {% if page.social %}
          <nav aria-label="Contact links">
            <ul class="profile-links">
              {% if site.data.socials.email %}
                <li><a href="mailto:{{ site.data.socials.email | encode_email }}">Email</a></li>
              {% endif %}
              {% if site.data.socials.github_username %}
                <li><a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a></li>
              {% endif %}
              {% if site.data.socials.scholar_userid %}
                <li><a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a></li>
              {% endif %}
            </ul>
          </nav>
        {% endif %}
      </div>
    </div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest Posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Experience -->
    {% if page.experience and page.experience.enabled %}
      {% include experience.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Honors and service (hardcoded; edit items inline here) -->
    <h2>Honors &amp; Service</h2>
    <ul>
      <li>
        <strong>2026 &nbsp;·&nbsp; President Award of the Chinese Academy of Sciences &mdash; Excellence</strong>
        <small class="d-block mt-1 mb-2"><em class="text-muted">Top 0.6% &nbsp;·&nbsp; The highest honor for graduate students at CAS</em></small>
      </li>
      <li><strong>2025</strong> &nbsp;·&nbsp; National Scholarship for Doctoral Students</li>
      <li><strong>Academic Service</strong> &nbsp;·&nbsp; Reviewer for ICML'26, NeurIPS'26, ICLR'27</li>
    </ul>

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}

    {% include mottos.liquid %}
  </article>
</div>
