{% comment %}Deterministic positions keep the sky stable across builds; no runtime script is needed.{% endcomment %}
<div class="home-sky" aria-hidden="true">
  <div class="home-sky-glow"></div>
  <div class="home-sky-stars">
    {% for i in (1..84) %}
      {% assign x = i | times: 7919 | modulo: 997 | divided_by: 10.0 %}
      {% assign y = i | times: 6271 | modulo: 991 | divided_by: 10.0 %}
      {% assign size = i | modulo: 3 | times: 0.4 | plus: 0.8 %}
      {% assign duration = i | modulo: 7 | plus: 6 %}
      {% assign delay = i | modulo: 13 | times: -1 %}
      <span
        class="home-sky-star"
        style="--x: {{ x }}%; --y: {{ y }}%; --size: {{ size }}px; --duration: {{ duration }}s; --delay: {{ delay }}s;"
      ></span>
    {% endfor %}
  </div>
</div>
