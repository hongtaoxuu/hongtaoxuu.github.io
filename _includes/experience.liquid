<div class="experience">
  {% for entry in site.data.experience %}
    <h2>{{ entry.title }}</h2>
    {% if entry.type == 'time_table' %}
      <ul class="card-text font-weight-light list-group list-group-flush">
        {% for content in entry.contents %}
          <li class="list-group-item py-2">
            <div class="d-flex flex-row justify-content-between align-items-baseline">
              {% if content.title %}
                <h6 class="title font-weight-bold mb-1 pr-2">{{ content.title }}</h6>
              {% endif %}
              {% if content.year %}
                <span class="text-muted text-nowrap ml-3">{{ content.year }}</span>
              {% endif %}
            </div>
            {% if content.institution %}
              <div class="mb-1">{{ content.institution }}</div>
            {% endif %}
            {% if content.department %}
              <div class="mb-1">{{ content.department }}</div>
            {% endif %}
            {% if content.description %}
              <ul class="items mb-0 pl-3">
                {% for item in content.description %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            {% endif %}
            {% if content.items %}
              <ul class="items mb-0 pl-3">
                {% for item in content.items %}
                  <li>{{ item }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      {{ entry.contents }}
    {% endif %}
  {% endfor %}
</div>
