<section class="personal-mottos" aria-label="Personal mottos">
  <figure class="mission-motto">
    <blockquote>
      <p>{{ site.data.mottos.mission | escape }}</p>
    </blockquote>
    <figcaption>&mdash; {{ site.data.mottos.attribution | escape }}</figcaption>
  </figure>
  <p class="motto-values">{{ site.data.mottos.values | escape }}</p>
  <p class="motto-meaning">{{ site.data.mottos.meaning | escape }}</p>
</section>
